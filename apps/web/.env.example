# Copy to .env.local for local overrides. Never commit .env files.
# live (default) talks to Lane A's API; mock plays DEV MOCK scripted runs (development only).
VITE_API_MODE=live
# Base URL prefix for API calls. Empty = same origin (the Vite dev proxy forwards /api).
VITE_API_BASE=
# Where the dev proxy forwards /api.
VITE_API_PROXY_TARGET=http://localhost:3001
