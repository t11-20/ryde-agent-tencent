# Copy to .env locally or set backend variables in your CNB workspace.
# No credentials are needed for stub development.
RUN_MODE=stub
API_HOST=127.0.0.1
API_PORT=3001
# Runtime model: MiniMax-M3 (OpenAI-compatible endpoint)
# Put your own key in .env only. Never commit it and never use a VITE_ prefix for model secrets.
MODEL_API_KEY=your-api-key-here
MODEL_BASE_URL=https://api.minimax.io/v1
MODEL_NAME=MiniMax-M3
# Optional JSON object merged into every model request. Use single quotes, e.g. '{"reasoning_split":true}' for MiniMax-M3
MODEL_EXTRA_BODY='{"reasoning_split":true}'
