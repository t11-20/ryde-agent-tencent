# Copy to .env. Stub and replay modes need no credentials. Never commit .env.

# stub   = labelled contract examples, no model (development only)
# replay = recorded live run from apps/api/replays, no model (demo default)
# live   = real model calls; requires MODEL_API_KEY, MODEL_BASE_URL, MODEL_NAME
RUN_MODE=stub
API_HOST=127.0.0.1
API_PORT=3001

# Live mode only. Any OpenAI-compatible chat-completions endpoint over HTTPS.
# Verified with MiniMax-M3. Keep the key in .env only; never use a VITE_ prefix for model secrets.
MODEL_API_KEY=your-api-key-here
MODEL_BASE_URL=https://api.minimax.io/v1
MODEL_NAME=MiniMax-M3
# JSON object merged into every model request (single quotes). Required for MiniMax-M3.
MODEL_EXTRA_BODY='{"reasoning_split":true}'

# Optional, MiniMax only. Thinking depth: adaptive (default), off, or default (send no thinking field).
# Set to off if live runs hit the 90-second deadline.
# MODEL_THINKING=adaptive

# Optional. A completed live run below this model-assessed confidence is escalated to human review (0..1).
# ESCALATION_CONFIDENCE_THRESHOLD=0.80

# Replay mode only. Recording folder relative to the repository root, and the playback speed divisor (1 = real time).
# REPLAY_DIR=apps/api/replays/20261013-144417
# REPLAY_SPEED=1
