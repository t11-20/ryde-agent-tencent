# Copy to .env locally or set backend variables in your CNB workspace.
# No credentials are needed for stub development.
RUN_MODE=stub
API_HOST=127.0.0.1
API_PORT=3001
# Runtime model: MiniMax-M3 (OpenAI-compatible endpoint)
# Put your own key in .env only. Never commit it and never use a VITE_ prefix for model secrets.
MODEL_API_KEY=your-api-key-here
MODEL_BASE_URL=https://api.minimax.io/v1
MODEL_NAME=MiniMax-M3
# Optional JSON object merged into every model request. Use single quotes, e.g. '{"reasoning_split":true}' for MiniMax-M3
MODEL_EXTRA_BODY='{"reasoning_split":true}'
# Thinking depth for the Judge and advocate case calls: default sends no thinking field, adaptive lets the model decide, off disables it.
# MiniMax only — other providers control thinking via MODEL_EXTRA_BODY (e.g. DashScope: '{"enable_thinking":false}').
# MODEL_THINKING=adaptive
# Provider service tier: 'priority' opts into the provider's priority lane. MiniMax only.
# MODEL_SERVICE_TIER=standard
# Judge confidence at or above this value skips human review (0..1, live mode only)
# ESCALATION_CONFIDENCE_THRESHOLD=0.80
# Replay mode serves the recorded events of a past live gate; no model is called and MODEL_* is not required.
# RUN_MODE=replay
# Folder of raw eval run records (runs/<FIXTURE>-1.json), resolved relative to the repo root.
# REPLAY_DIR=apps/api/replays/20261013-144417
# Recorded event offsets are divided by this speed; 1 replays in real time.
# REPLAY_SPEED=1
